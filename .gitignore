# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / IDEs
/.idea
/.vscode/*
!/.vscode/settings.json
!/.vscode/extensions.json
*.swp
*.swo
*~

# OS junk
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# logs
*.log
logs/

# temp / cache
.tmp/
.cache/
/.plugin-cache/
.eslintcache
.stylelintcache

# puku editor
/.puku

# local AI agent instructions
/AGENTS.md
/CLAUDE.md

# local scratch / one-off scripts
/_my-mongodb-app-template/
/test-gemini-verify.ps1
/test-gemini.ps1
/trigger.ps1

# editor / tool caches
/.plugin-cache

# vendored reference templates (keep their node_modules out of the repo)
/_my-mongodb-app-template
/_my-mongodb-app-template/**

# extra local-only ignores
# OS / shell noise
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# local env overrides
.env.local
.env.*.local

# turbo / nx caches
.turbo/
.nx/cache
